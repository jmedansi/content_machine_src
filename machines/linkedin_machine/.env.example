# Google Sheets (pour gspread)
# Chemin vers le fichier JSON des identifiants du compte de service
GOOGLE_SERVICE_ACCOUNT_JSON=service_account.json
# ID de la Google Sheet
GOOGLE_SHEET_ID=...
