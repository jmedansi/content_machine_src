# ─── Modèles d'IA pour la rédaction (source PRIMAIRE : accounts.settings via le dashboard) ───
# L'utilisateur saisit sa clé API / URL de base directement dans le dashboard
# (Paramètres → Comptes). Les variables ci-dessous servent de REPLI si le
# compte n'a pas de clé renseignée.

# --- Fournisseurs supportés par core/llm_router.py ---
# OpenAI (GPT-4o, o3-mini, GPT-4.1)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# Anthropic (Claude Sonnet / Opus)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_BASE_URL=https://api.anthropic.com/v1

# Google Gemini (texte — endpoint OpenAI-compatible)
# GEMINI_API_KEY=AIza...
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# DeepSeek
# DEEPSEEK_API_KEY=sk-...
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenRouter (une clé = accès à ~300 modèles)
# OPENROUTER_API_KEY=sk-or-...
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Mistral
# MISTRAL_API_KEY=...
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# --- Fournisseurs existants (inchangés) ---
GROQ_API_KEY=gsk_...
KIMI_API_KEY=sk-...
KIMI_BASE_URL=https://api.moonshot.ai/v1
OLLAMA_URL=http://localhost:11434

# --- Modèle par défaut (fallback global si aucun compte n'a de choix) ---
DEFAULT_LLM_MODEL=llama-3.3-70b-versatile
FACEBOOK_LLM_MODEL=llama-3.3-70b-versatile
LINKEDIN_LLM_MODEL=llama-3.3-70b-versatile
TWITTER_LLM_MODEL=llama-3.3-70b-versatile
